FROM node:latest

WORKDIR /app

COPY package*.json ./

RUN npm install --force

COPY . .

ARG VITE_DEMO_ENABLED
ARG VITE_DEMO_USERNAMES
ARG VITE_DEMO_PASSWORD

ENV VITE_DEMO_ENABLED=$VITE_DEMO_ENABLED
ENV VITE_DEMO_USERNAMES=$VITE_DEMO_USERNAMES
ENV VITE_DEMO_PASSWORD=$VITE_DEMO_PASSWORD

RUN npm run build

CMD ["npm", "run", "preview"]